# Copy this file to .env and fill in your values.
# `.env.example` is meant to stay in git as a safe template.
# `.env` should stay local and is ignored by `.gitignore`.

# MongoDB connection string (local Docker via `npm run db:up`, or Atlas)
MONGODB_URI=mongodb://localhost:27017/apartment

# Frontend/API port (3000 is often taken by Docker on this machine)
PORT=3001

# Default currency label shown in the UI if listing data has no explicit currency
LISTING_CURRENCY=GEL

# --- myhome.ge collector ---
# Path to Chrome (used to open myhome.ge; Cloudflare blocks plain HTTP requests)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Headless Chrome is blocked by Cloudflare, so keep this false unless that changes
MYHOME_HEADLESS=false
# Optional: limit to specific street IDs
# MYHOME_STREETS=1146,1147,2948
# Pause between result pages (be polite to the site)
MYHOME_PAGE_DELAY_MS=1500

# --- pipeline ---
# Each results page has 24 listings
PIPELINE_START_PAGE=1
PIPELINE_MAX_PAGES=5
# Max new/changed listings to run through CLIP in one run
PIPELINE_MAX_LISTINGS=100
# true = re-run CLIP even for listings that did not change
PIPELINE_FORCE=false
# > 0 = keep running and refresh every N minutes
PIPELINE_INTERVAL_MINUTES=0

# --- duplicates ---
# Photo match threshold (CLIP cosine). 0.85 groups different apartments with similar
# renovations; 0.92 keeps only near-identical photos. Rule: >6 photos, >=51% matching.
DUPLICATE_SIM_THRESHOLD=0.92
