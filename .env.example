# Copy this file to .env and fill in your values.
# Do not commit .env to git (add .env to .gitignore).

# tnet statements API (apartment listings)
TNET_API_URL=https://api-statements.tnet.ge/v1/statements
# Optional: if API returns 403, add headers from a working Postman request as JSON, e.g. {"Cookie": "..."}
# TNET_EXTRA_HEADERS={"Cookie": "your-session-cookie"}

# MongoDB connection string (e.g. local or Atlas)
MONGODB_URI=mongodb://localhost:27017/apartment
